{
  "exclude": [
    "ztest",
    "zdocs",
    "build",
    "dist",
    "**/__pycache__",
    "**/*.egg-info"
  ],
  "extraPaths": [".."],
  "venvPath": "../..",
  "venv": "anaconda3",
  "typeCheckingMode": "basic",
  "pythonVersion": "3.11",

  "ignore": [
    "common/observability/langfuse_backend.py",
    "common/observability/langfuse_integration.py",
    "router/ml/v4_features.py",
    "memory/procedural_memory/manager.py",
    "durable_exec/temporal"
  ],

  "reportMissingImports": "error",
  "reportMissingModuleSource": "warning"
}
