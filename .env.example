# mote example environment file.
#
# Copy to `.env` and fill in real values (`.env` is git-ignored — never commit it).
# These are OPTIONAL: mote's primary config source is the layered config
# stack (see common/config/ and README). Environment variables sit in the ENV
# layer and override lower layers.
#
# Two independent mechanisms live here:
#   1. Provider API keys — plain, well-known names read directly by the LLM layer.
#   2. MOTE_ overrides   — map onto the layered config tree; `__` nests, a single
#                          `_` stays within a segment, e.g.
#                          MOTE_MODELS__DEFAULT__BASE_URL -> config.models.default.base_url

# ---------------------------------------------------------------------------
# LLM provider API keys (set the one(s) for the provider you use)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
ZHIPUAI_API_KEY=
DASHSCOPE_API_KEY=
# GitHub Copilot backend uses a token instead of an API key:
COPILOT_GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Layered-config overrides (MOTE_ prefix; `__` separates nesting levels)
# ---------------------------------------------------------------------------
# Select a named config profile (see common/config/loader.py).
# MOTE_PROFILE=default

# Override the LLM endpoint / model without editing config.yaml.
# MOTE_MODELS__DEFAULT__BASE_URL=https://api.openai.com/v1
# MOTE_MODELS__DEFAULT__MODEL=gpt-4o

# Force the project root used for relative path resolution.
# MOTE_PROJECT_ROOT=/path/to/project

# UI language for the human-facing CLI (zh | en). Model-facing text stays English.
# MOTE_UI__LANGUAGE=zh

# Role name reported by the run reporter.
# MOTE_ROLE=

# OAuth token-URL overrides (advanced; only if you self-host a token endpoint).
# MOTE_OAUTH_OPENAI_TOKEN_URL=
# MOTE_OAUTH_ANTHROPIC_TOKEN_URL=
# MOTE_OAUTH_GITHUB_COPILOT_TOKEN_URL=

# ---------------------------------------------------------------------------
# Observability (optional; Langfuse tracing is off/lazy by default)
# ---------------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_SAMPLE_RATE=1.0

# Run reporter endpoint (optional).
# MOTE_REPORTER_URL=

# Error reporting (optional).
# SENTRY_DSN=
