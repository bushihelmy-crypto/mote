# Controls what goes into the source distribution (sdist).
include LICENSE
include NOTICE
include README.md
include ruff.toml

# First-run bootstrap reads this to seed ~/.mote/config.yaml
# (see common/config/bootstrap.py). It MUST ship in the package.
include config.example.yaml

# Third-party license texts (see NOTICE for attributions).
recursive-include zthird_party_licenses *.txt

# Ship non-Python data files that the package needs at runtime.
recursive-include router *.yaml
recursive-include roles *.yaml

# Keep tests, dev tooling, and local artifacts out of the dist.
prune ztest
prune zdocs
prune .claude
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
